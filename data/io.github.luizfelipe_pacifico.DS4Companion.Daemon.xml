<!-- Interface do ds4-companiond (ADR 0008). Gerado de src/ds4_companion/daemon/dbus.py;
     o teste tests/unit/daemon/test_dbus.py confere que os dois batem. -->
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="io.github.luizfelipe_pacifico.DS4Companion.Daemon">
    <method name="DeleteProfile">
      <arg name="serial" direction="in" type="s"/>
    </method>
    <method name="GetProfiles">
      <arg direction="out" type="a{sa{sv}}"/>
    </method>
    <method name="PlayTestTone"/>
    <method name="Refresh"/>
    <method name="RestoreDefaults"/>
    <method name="SetApps">
      <arg name="apps" direction="in" type="as"/>
    </method>
    <method name="SetBackup">
      <arg name="enabled" direction="in" type="b"/>
    </method>
    <method name="SetLed">
      <arg name="color" direction="in" type="s"/>
    </method>
    <method name="SetLedMode">
      <arg name="mode" direction="in" type="s"/>
    </method>
    <method name="SetLimiter">
      <arg name="enabled" direction="in" type="b"/>
    </method>
    <method name="SetMirror">
      <arg name="enabled" direction="in" type="b"/>
    </method>
    <method name="SetPlayers">
      <arg name="players" direction="in" type="ai"/>
    </method>
    <method name="SetProfile">
      <arg name="serial" direction="in" type="s"/>
      <arg name="values" direction="in" type="a{sv}"/>
      <arg name="confirm" direction="in" type="b"/>
    </method>
    <method name="SetRpcs3Dir">
      <arg name="path" direction="in" type="s"/>
    </method>
    <method name="SetVibration">
      <arg name="large" direction="in" type="u"/>
      <arg name="small" direction="in" type="u"/>
      <arg name="swap" direction="in" type="b"/>
    </method>
    <method name="SetVolume">
      <arg name="db" direction="in" type="d"/>
      <arg name="confirm" direction="in" type="b"/>
      <arg direction="out" type="d"/>
    </method>
    <method name="TestRumble">
      <arg name="motor" direction="in" type="s"/>
    </method>
    <property name="Status" type="a{sv}" access="read"/>
    <property name="Version" type="s" access="read"/>
  </interface>
</node>
