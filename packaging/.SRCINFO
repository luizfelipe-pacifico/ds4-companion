pkgbase = ds4-companion
	pkgdesc = O som do RPCS3 em paralelo no DualShock 4, com volume em dB, vibração e cor da luz
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/luizfelipe-pacifico/ds4-companion
	install = ds4-companion.install
	arch = any
	license = GPL-3.0-or-later
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-setuptools
	makedepends = python-wheel
	makedepends = glib2
	depends = python
	depends = python-gobject
	depends = gtk4
	depends = libadwaita
	depends = python-pyudev
	depends = python-dbus-next
	depends = inter-font
	depends = pipewire
	depends = wireplumber
	depends = systemd
	optdepends = rpcs3-bin: o emulador cujo som vai para o controle
	optdepends = gamemode: desempenho ao abrir o RPCS3
	optdepends = bluez: controle por Bluetooth

pkgname = ds4-companion
